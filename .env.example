# ===========================================
# ProductFindAI — Environment Variables
# ===========================================
# Copy this to .env.local and fill in your values

# --- Query planning AI ---
# Direct Gemini 2.5 Flash-Lite is the low-cost default.
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key_here
# Optional: use funded Vercel AI Gateway for Gemini 3.1 Flash-Lite.
PRODUCTFIND_USE_AI_GATEWAY=false
# AI_GATEWAY_API_KEY=your_funded_vercel_ai_gateway_api_key_here

# --- Supabase ---
# The service role key is used by server-only caches, operational logs, and
# shared request budgets. Keep it server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Dedicated HMAC secret for pseudonymizing IP addresses in operational logs
# and rate-limit buckets. Generate at least 32 random bytes. Never expose it
# through a NEXT_PUBLIC_* variable.
ANALYTICS_HASH_SECRET=replace_with_at_least_32_random_bytes

# Shared safeguards. Defaults are 10 searches/IP/minute and 500 searches/day.
PRODUCTFIND_SEARCHES_PER_MINUTE=10
PRODUCTFIND_DAILY_SEARCH_LIMIT=500

# --- Amazon Associates ---
# Sign up at: https://affiliate-program.amazon.com
# This tag is used for website click-through links when a Creators API
# PartnerTag is not otherwise set.
NEXT_PUBLIC_AMAZON_TAG=purefind-20

# --- Amazon Creators API (required) ---
# Docs: https://affiliate-program.amazon.com/creatorsapi/docs/en-us/introduction
# Step-by-step: docs/amazon-paapi-setup.md
# Requires final Associates acceptance and qualifying sales. Amazon's current
# Creators API docs say at least 10 qualifying sales within the past 30 days.
AMAZON_CREATORS_API_CREDENTIAL_ID=your_creators_api_credential_id_here
AMAZON_CREATORS_API_CREDENTIAL_SECRET=your_creators_api_credential_secret_here
AMAZON_CREATORS_API_CREDENTIAL_VERSION=v3.1
AMAZON_CREATORS_API_PARTNER_TAG=purefind-20
AMAZON_CREATORS_API_MARKETPLACE=www.amazon.com

# --- Site Config ---
NEXT_PUBLIC_SITE_NAME=ProductFindAI
NEXT_PUBLIC_SITE_URL=https://productfindai.com
